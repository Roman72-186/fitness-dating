# PostgreSQL — учётные данные для docker-compose
POSTGRES_USER=fituser
POSTGRES_PASSWORD=your_strong_password_here

# Prisma connection string
# В docker-compose собирается автоматически.
# Для локальной разработки без Docker:
DATABASE_URL=postgresql://fituser:password@localhost:5432/fitness_dating

# JWT — минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Защита /api/auth/by-id (серверные интеграции: бот → JWT)
# Сгенерировать: openssl rand -hex 16
SYNC_SECRET=

# Админка статистики. Пароль не коммитить, хранить только в env.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Telegram Bot Token — верификация initData + уведомления о лайках и мэтчах
TELEGRAM_BOT_TOKEN=

# WATBOT API Token — только для импорта анкет через /api/admin/sync-from-watbot
WATBOT_API_TOKEN=

# Защита /api/bot/register-profile (заголовок x-webhook-secret)
# Сгенерировать: openssl rand -hex 16
BOT_WEBHOOK_SECRET=

# S3-хранилище для фото анкет
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1
S3_PREFIX=fitness-dating/avatars
# Опционально: публичный CDN/домен для файлов. Если пусто, строится URL через endpoint/bucket/key
S3_PUBLIC_BASE_URL=

# Legacy: Supabase Storage больше не используется для загрузки фото
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — опционально, кэш ленты (5 мин TTL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev режим: true — мок-данные вместо БД, токен всё равно нужен
DEV_MODE=false
